---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "Contact — WhenSpace";
const description = "Get in touch with the WhenSpace team.";
---

<Layout title={title} description={description}>
  <Nav />

  <!-- PAGE HEADER -->
  <div class="pt-14">
    <div class="border-b border-black/10 py-16 px-5">
      <div class="max-w-2xl mx-auto">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-black/40 mb-3">Get in touch</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest mb-4">Contact</h1>
        <p class="text-base text-black/55 leading-relaxed">
          Questions, feedback, or just want to say hi? We'd love to hear from you.
        </p>
      </div>
    </div>
  </div>

  <!-- CONTENT -->
  <main class="py-16 px-5">
    <div class="max-w-2xl mx-auto">

      <!-- Email block -->
      <div class="border border-black/10 p-8 mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-black/40 mb-3">Email us</p>
        <a href="mailto:hello@whenspace.app"
           class="text-2xl font-bold tracking-tightest hover:opacity-60 transition-opacity duration-150">
          hello@whenspace.app
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
