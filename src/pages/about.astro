---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const title = "About — WhenSpace";
const description = "About WhenSpace — the team and legal entity behind the app.";
---

<Layout title={title} description={description}>
  <Nav />

  <!-- PAGE HEADER -->
  <div class="pt-14">
    <div class="border-b border-black/10 py-16 px-5">
      <div class="max-w-2xl mx-auto">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-black/40 mb-3">About</p>
        <h1 class="text-4xl sm:text-5xl font-bold tracking-tightest mb-4">WhenSpace</h1>
        <p class="text-base text-black/55 leading-relaxed max-w-xl">
          A focused productivity app that unifies your tasks, events, and habits into one calm space —
          built for people who want less noise and more done.
        </p>
      </div>
    </div>
  </div>

  <!-- CONTENT -->
  <main class="py-16 px-5">
    <div class="max-w-2xl mx-auto prose-page">
      <h2>Legal information</h2>
      <p>
        WhenSpace is developed and published by <strong class="text-black">Marcin Syngajewski</strong>.
      </p>

      <p>
        For any legal or business enquiries, please use the <a href="/contact">contact page</a>.
        For data-related questions, see our <a href="/privacy">Privacy Policy</a>.
      </p>
    </div>
  </main>

  <Footer />
</Layout>
